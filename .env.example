# ==============================================================================
# DUBAI FINANCE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and fill in your actual production values.
# NEVER commit the real .env file containing live secrets to GitHub or Git.

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon Pooler & Direct)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=dubaifinance"
DIRECT_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require&schema=dubaifinance"

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (Minimum 32 characters in production)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="generate-a-secure-random-64-character-jwt-secret-key-here"

# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET="generate-a-secure-32-byte-hex-encryption-key-here"

# ------------------------------------------------------------------------------
# 3. Master Cron Execution Secret
# ------------------------------------------------------------------------------
# Required to trigger midnight ROI distributions via curl / GitHub Actions / Vercel Cron
CRON_SECRET="generate-a-secure-cron-secret-key-here"

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Upstash Redis REST API)
# ------------------------------------------------------------------------------
# Optional in development (falls back to in-memory sliding window).
# Recommended in production for distributed serverless protection.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-rest-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
FAIL_CLOSED_WITHOUT_REDIS="false"

# ------------------------------------------------------------------------------
# 5. Email & OTP Verification (Gmail SMTP / Nodemailer)
# ------------------------------------------------------------------------------
GMAIL_USER="dubaifinance.support@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_NAME="Dubai Finance Security"

# ------------------------------------------------------------------------------
# 6. Application Metadata & Public URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Dubai Finance"
NEXT_PUBLIC_APP_URL="https://dubaifinance.online"
USDT_TO_INR_RATE=110
