generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ROOT_ADMIN
  SUPER_ADMIN
  ADMIN
  USER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PackageType {
  BASIC_SAVING
  FIX_DEPOSIT
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  SIGNUP_BONUS
  DEPOSIT
  BASIC_ROI
  FD_ROI
  DIRECT_REFERRAL
  DIRECT_SPONSOR_BONUS
  UPLINE_OVERRIDE_BONUS
  RANK_REWARD_CASHOUT
  RANK_UPGRADE_HOLD
  COMMISSION_WITHDRAWAL
  BASIC_LEVEL_INCOME
  FD_LEVEL_INCOME
  P2P_SENT
  P2P_RECEIVED
  SWIPE_INCOME_TO_FUND
  PACKAGE_PURCHASE
  WITHDRAWAL
  WITHDRAWAL_REFUND
}

model User {
  id              String         @id @default(cuid())
  customId        String         @unique // e.g. "DF836419"
  fullName        String
  email           String         @unique
  phone           String?
  passwordHash    String
  transactionPin  String?        // 6-digit PIN hash
  role            UserRole       @default(USER)
  status          AccountStatus  @default(INACTIVE)
  
  sponsorId       String?
  sponsor         User?          @relation("ReferralTree", fields: [sponsorId], references: [id])
  directs         User[]         @relation("ReferralTree")
  
  adminId         String?        // Root branch admin ID this user belongs to
  assignedAdmin   User?          @relation("AdminTeamMembers", fields: [adminId], references: [id])
  teamMembers     User[]         @relation("AdminTeamMembers")
  teamPrefix      String?        // Admin branch team prefix (e.g. "1" for DF1xxxxx, "2" for DF2xxxxx)
  depositMode     String?        @default("GLOBAL") // Admin branch deposit mode: "GLOBAL", "AUTOMATIC", "MANUAL"
  
  usdtAddress     String?        // BEP-20 address
  
  fundBalance     Decimal        @default(0.0) @db.Decimal(20, 8)
  incomeBalance   Decimal        @default(0.0) @db.Decimal(20, 8)
  fdLockedBalance Decimal        @default(0.0) @db.Decimal(20, 8)
  totalWithdrawn  Decimal        @default(0.0) @db.Decimal(20, 8)
  directBusiness  Decimal        @default(0.0) @db.Decimal(20, 8)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Unused legacy columns to keep Prisma sync non-destructive
  currentRank          Int            @default(0)
  rankHoldingValue     Decimal        @default(0.0) @db.Decimal(20, 8)
  autoUpgradeEnabled   Boolean        @default(true)
  isRankBanned         Boolean        @default(false)
  isUltimaCompleted    Boolean        @default(false)

  contracts       InvestmentContract[]
  ledgers         LedgerEntry[]
  deposits        DepositRequest[]
  withdrawals     WithdrawalRequest[]
  depositAddresses DepositAddress[]
  adminDepositPermissions AdminDepositPermission[]
  tickets         SupportTicket[]
  queuePositions  QueuePosition[]
  loginSessions   LoginSession[]
  activityLogs    ActivityLog[]
}

model InvestmentContract {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  packageType    PackageType
  amountInInr    Decimal        @db.Decimal(20, 2)
  amountInUsdt   Decimal        @db.Decimal(20, 8)
  dailyRoiRate   Decimal        @db.Decimal(5, 2) // 5.0 for Basic, 10.0 or 15.0 for FD
  tenureDays     Int            // 25 for Basic, 180 or 210 for FD
  daysPaid       Int            @default(0)
  totalEarned    Decimal        @default(0.0) @db.Decimal(20, 8)
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime       @default(now())
  maturityDate   DateTime
  lastRoiAt      DateTime?
  createdAt      DateTime       @default(now())
}

model LedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  type           TransactionType
  wallet         String          // "FUND", "INCOME", "FD_LOCKED"
  amount         Decimal         @db.Decimal(20, 8)
  balanceAfter   Decimal         @db.Decimal(20, 8)
  referenceKey   String          @unique
  description    String
  sourceUserId   String?
  levelNumber    Int?
  createdAt      DateTime        @default(now())
}

model DepositRequest {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  amountInUsdt     Decimal         @db.Decimal(20, 8)
  amountInInr      Decimal         @db.Decimal(20, 2)
  txHash           String          @unique
  network          String          @default("USDT_BEP20")
  screenshotUrl    String?
  adminNote        String?
  status           String          @default("PENDING") // PENDING, CONFIRMING, CONFIRMED, PENDING_REVIEW, MANUAL_REVIEW, APPROVED, REJECTED, CREDITED, FAILED
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())

  depositAddressId String?
  depositAddress   DepositAddress? @relation(fields: [depositAddressId], references: [id])
  tokenContract    String?
  fromAddress      String?
  toAddress        String?
  blockNumber      BigInt?
  transactionIndex Int?
  logIndex         Int?
  confirmations    Int             @default(0)
  processingMode   String          @default("MANUAL") // AUTOMATIC, MANUAL
  verifiedTxHash   String?
  detectedAt       DateTime?
  confirmedAt      DateTime?
  creditedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  approvalNotes    String?
  failureReason    String?

  @@index([toAddress, tokenContract])
  @@index([processingMode, status])
  @@index([blockNumber])
}

model WithdrawalRequest {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  amountInInr    Decimal         @db.Decimal(20, 2)
  amountInUsdt   Decimal         @db.Decimal(20, 8)
  feePercent     Decimal?        @default(10.0) @db.Decimal(5, 2)
  feeAmount      Decimal?        @default(0.0) @db.Decimal(20, 8)
  netAmount      Decimal?        @default(0.0) @db.Decimal(20, 8)
  toAddress      String
  network        String          @default("USDT_BEP20")
  txHash         String?
  adminNote      String?
  status         String          @default("PENDING") // PENDING, PROCESSED, REJECTED
  processedAt    DateTime?
  createdAt      DateTime        @default(now())
}

model SupportTicket {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  subject        String
  category       String
  message        String
  status         String          @default("OPEN") // OPEN, ANSWERED, CLOSED
  adminReply     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model SystemConfig {
  id             String          @id @default(cuid())
  key            String          @unique
  value          String
  description    String?
  updatedAt      DateTime        @updatedAt
}

model OtpVerification {
  id             String          @id @default(cuid())
  email          String
  otp            String
  purpose        String          @default("REGISTRATION") // REGISTRATION, FORGOT_PASSWORD, etc.
  expiresAt      DateTime
  createdAt      DateTime        @default(now())

  @@index([email, purpose])
}

enum QueueStatus {
  WAITING
  COMPLETED
  EXITED
}

model QueuePosition {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  rankTier       Int
  rankName       String
  entryAmount    Decimal      @db.Decimal(20, 8)
  rankValue      Decimal      @db.Decimal(20, 8)
  child1Id       String?
  child2Id       String?
  childrenCount  Int          @default(0)
  status         QueueStatus  @default(WAITING)
  queueOrder     BigInt
  completedAt    DateTime?
  exitedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([rankTier, status, queueOrder])
  @@index([userId])
}

model LoginSession {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress     String
  userAgent     String?
  browser       String?
  os            String?
  device        String?      // "Desktop" | "Mobile" | "Tablet" | "Unknown"
  country       String?
  city          String?
  region        String?
  portal        String       // "MEMBER" | "ADMIN" | "SUPER_ROOT"
  status        String       @default("SUCCESS") // "SUCCESS" | "FAILED"
  failureReason String?
  isActive      Boolean      @default(true)
  lastActiveAt  DateTime     @default(now())
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, isActive])
  @@index([ipAddress])
  @@index([createdAt])
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String       // "LOGIN", "PROFILE_UPDATE", "CHANGE_PASSWORD", "WITHDRAWAL_REQUEST", "DEPOSIT_REQUEST", "P2P_TRANSFER", "SWIPE_FUNDS", "PACKAGE_ACTIVATION", "ADMIN_CONFIG_UPDATE", etc.
  category    String       // "AUTH", "SECURITY", "FINANCIAL", "ADMIN", "PROFILE"
  description String
  ipAddress   String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  country     String?
  city        String?
  metadata    String?      // JSON payload / context
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([category])
  @@index([ipAddress])
  @@index([createdAt])
}

model DepositAddress {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  network         String           @default("BSC")
  asset           String           @default("USDT")
  address         String           @unique
  derivationIndex Int              @default(0)
  status          String           @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deposits        DepositRequest[]

  @@index([userId, status])
  @@index([address])
}

model BlockchainCheckpoint {
  id                 String    @id // e.g. "bsc_usdt_mainnet"
  network            String    @default("BSC")
  lastProcessedBlock BigInt    @default(0)
  latestKnownBlock   BigInt    @default(0)
  status             String    @default("STOPPED") // RUNNING, IDLE, ERROR, STOPPED
  lastSuccessfulScan DateTime?
  lastError          String?
  updatedAt          DateTime  @updatedAt
}

model AdminDepositPermission {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission  String   // e.g. "deposit.view", "deposit.approve", "deposit.reject", "deposit.reconcile", "deposit.mode.change", "deposit.system.pause", "deposit.settings.update"
  grantedById String
  createdAt   DateTime @default(now())

  @@unique([adminId, permission])
  @@index([adminId])
}

